# ==============================================================================
# GlobalPulse AI Backend Environment Configuration Template
# Every value here is left empty for security. Never commit real secrets.
# ==============================================================================

# Master secret key for administrative endpoints and worker sync (minimum 16 characters required)
ADMIN_SECRET_KEY=

# Database connection URL (PostgreSQL / Neon DB or SQLite fallback, e.g. postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=

# Allowed frontend origin for CORS and client authentication callbacks (e.g. https://globalpulseai.vercel.app)
FRONTEND_URL=

# Allowed CORS origins as comma-separated list (e.g. https://globalpulseai.vercel.app,http://localhost:3000)
CORS_ORIGINS=

# Backend server base URL used by server-side proxy and API routes (e.g. http://YOUR_SERVER_IP or https://api.yourdomain.com)
BACKEND_URL=

# Canonical public base URL of the web platform for metadata and video watermarks
PUBLIC_SITE_URL=

# Server port for the FastAPI backend (defaults to 8000)
PORT=

# Google Gemini API key for automated article summarization, analysis, and scriptwriting
GEMINI_API_KEY=

# Enable or disable automated 24/7 background news ingestion pipeline (true/false)
AUTO_PIPELINE_ENABLED=

# Interval in minutes between automated news scraping and publishing runs (default: 15)
AUTO_PIPELINE_INTERVAL_MINUTES=

# Optional interval in hours between pipeline runs (overrides minutes if set)
AUTO_PIPELINE_INTERVAL_HOURS=

# Number of news stories to fetch and process in each pipeline batch run (default: 1)
AUTO_PIPELINE_BATCH_SIZE=

# Daily maximum limit for automatically published articles (default: 60)
DAILY_PUBLISHING_CAP=

# Toggle to allow video rendering directly on cloud host (defaults to false to prevent OOM)
CLOUD_VIDEO_RENDER_ENABLED=

# Base URL of the deployed cloud backend used by local_worker for token synchronization
RENDER_URL=

# Search engine IndexNow verification key for automatic search indexing submissions
INDEXNOW_KEY=

# Domain hostname for IndexNow URL submission (e.g. globalpulseai.vercel.app)
SITE_HOST=

# YouTube OAuth2 client secret configuration as raw JSON string
YOUTUBE_CLIENT_SECRET_JSON=

# YouTube OAuth2 user token configuration as raw JSON string
YOUTUBE_TOKEN_JSON=

# Facebook Page ID for automated social media news posting
FACEBOOK_PAGE_ID=

# Long-lived Facebook Page Access Token with publish permissions
FACEBOOK_PAGE_ACCESS_TOKEN=

# TikTok for Developers client key for automated video sharing
TIKTOK_CLIENT_KEY=

# TikTok for Developers client secret for automated video sharing
TIKTOK_CLIENT_SECRET=
