# ==============================================================================
# GlobalPulse AI Root .gitignore
# Strictly excludes credentials, secrets, databases, dependencies, and media
# ==============================================================================

# Environment files and credentials
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.production.local
frontend/.env.development.local

# OAuth Credentials & Sensitive Tokens (MUST NOT BE COMMITTED)
client_secret*.json
token*.json
backend/client_secret*.json
backend/token*.json
*.pem
*.key
credentials.json

# Databases & SQLite files
*.db
*.db-journal
*.sqlite
*.sqlite3
globalpulse.db
backend/globalpulse.db

# Dependencies
node_modules/
frontend/node_modules/
backend/venv/
venv/
.venv/
env/
ENV/

# Python caches and bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Next.js and frontend build artifacts
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.turbo/

# Media artifacts & Generated Videos (Avoid large binary blobs in Git)
backend/static/videos/*
!backend/static/videos/.gitkeep
exports/
*.mp4
*.wav
*.mp3
test_pipeline_video*

# Temporary test screenshots
admin_*.png
detail_preview.png
screenshot.png

# Temporary logs & PID files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
